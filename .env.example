# ==========================================
# OMNIX Environment Configuration (.env)
# ==========================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true
APP_NAME=OMNIX
APP_VERSION=0.5.0

# Primary LLM Provider (Groq - default in PRD v0.5)
GROQ_API_KEY=
PRIMARY_LLM_MODEL=groq/llama-3.3-70b-versatile
FAST_LLM_MODEL=groq/llama-3.1-8b-instant

# Cloudflare Backup Provider
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Image & Video Provider Keys
FAL_KEY=
REPLICATE_API_TOKEN=

# TTS Settings (kokoro-onnx on CPU)
TTS_MODEL_PATH=
TTS_VOICE=af_heart

# Concurrency Controls
MAX_CONCURRENT_MANIM_RENDERS=3
